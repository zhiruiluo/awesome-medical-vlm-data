{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical VLM dataset record",
  "type": "object",
  "required": ["id", "name", "year", "license", "commercial_use", "domains", "modalities", "image_structure", "tasks", "capabilities", "usage", "catalog_status", "language_supervision", "derived_from", "annotation", "scale", "quality", "access", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 2000},
    "homepage": {"type": ["string", "null"], "format": "uri"},
    "paper": {"type": ["string", "null"], "format": "uri"},
    "repository": {"type": ["string", "null"], "format": "uri"},
    "download": {"type": ["string", "null"], "format": "uri"},
    "license": {"type": "string"},
    "commercial_use": {"enum": ["yes", "no", "unknown"]},
    "domains": {"type": "array", "minItems": 1, "items": {"$ref": "../taxonomies/domains.json"}},
    "modalities": {"type": "array", "minItems": 1, "items": {"$ref": "../taxonomies/modalities.json"}},
    "image_structure": {"type": "array", "minItems": 1, "items": {"enum": ["2d-single", "multi-view", "3d-volume", "whole-slide-image", "video", "longitudinal-sequence"]}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "../taxonomies/tasks.json"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "../taxonomies/capabilities.json"}},
    "usage": {"enum": ["training", "evaluation", "training-evaluation"]},
    "catalog_status": {"enum": ["included", "candidate", "excluded"]},
    "language_supervision": {"type": "array", "items": {"enum": ["caption", "report", "question-answer", "grounded-text", "instruction-dialogue", "reasoning-trace", "preference-pair", "none"]}},
    "derived_from": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "annotation": {"type": "object", "required": ["source", "expert_review", "grounding"]},
    "scale": {"type": "object", "required": ["primary_count", "primary_unit"]},
    "quality": {"type": "object", "required": ["contamination_audited", "patient_level_split", "external_validation", "known_issues"]},
    "access": {"type": "object", "required": ["registration_required", "credentialing_required", "gated", "data_use_agreement_required", "citation_required"]},
    "last_verified": {"type": "string", "format": "date"}
  }
}
