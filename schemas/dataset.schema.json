{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical VLM dataset record",
  "type": "object",
  "required": ["id", "name", "year", "license", "commercial_use", "domains", "modalities", "image_structure", "tasks", "capabilities", "usage", "annotation", "scale", "quality", "access", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "name": {"type": "string", "minLength": 1}, "year": {"type": "integer", "minimum": 2000},
    "homepage": {"type": ["string", "null"], "format": "uri"}, "paper": {"type": ["string", "null"], "format": "uri"}, "repository": {"type": ["string", "null"], "format": "uri"}, "download": {"type": ["string", "null"], "format": "uri"},
    "license": {"type": "string"}, "commercial_use": {"enum": ["yes", "no", "unknown"]},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "modalities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "image_structure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "usage": {"enum": ["training", "evaluation", "training-evaluation"]},
    "annotation": {"type": "object", "required": ["source", "expert_review", "grounding"]}, "scale": {"type": "object"}, "quality": {"type": "object", "required": ["contamination_audited", "patient_level_split", "external_validation", "known_issues"]}, "access": {"type": "object", "required": ["registration_required", "credentialing_required"]}, "last_verified": {"type": "string", "format": "date"}
  }
}
